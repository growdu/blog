# Build output
public/
/source/
!/source/all/
!/source/recommended/

# Dependencies
node_modules/

# OS
.DS_Store

# Editor
.vscode
.obsidian

# Misc
*.pdf
__pycache__/
.pytest_cache/

# Media assets (audio / video) — never committed, kept on local disk only.
# A single finished cut is 15~35 MB; 100 episodes would be GB-scale, and a
# binary blob in git is unreadable in every diff and review. What belongs in
# the repo is the reproducible input (scripts, storyboard contract, subtitle
# styles), not the rendered output.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.m4a
*.aac
*.flac

# Generated by localize-cdn.py in CI
tools/cdn-manifest.json

# Hexo generated index (regenerated by `hexo generate`)
db.json

# npm dependency lock (managed by release, not committed)
package-lock.json
