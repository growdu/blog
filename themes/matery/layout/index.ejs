<% if (is_home() && page.current === 1) { %>
<%- partial('_partial/index-cover') %>
<% } else { %>
    <%- partial('_partial/bg-cover') %>
<% } %>
<%- partial('_partial/bg-video') %>
<main class="content">

    <%
    var hashCode = function (str) {
        if (!str && str.length === 0) {
            return 0;
        }

        var hash = 0;
        for (var i = 0, len = str.length; i < len; i++) {
            hash = ((hash << 5) - hash) + str.charCodeAt(i);
            hash |= 0;
        }
        return hash;
    };

    var recentPosts = page.posts.slice(0, 18);
    %>

    <% if (page.current === 1 && theme.recommend.enable) { %>
    <div id="recommend-sections" class="recommend">
        <%- partial('_widget/recommend') %>
    </div>
    <% } %>

    <% if (page.current === 1 && recentPosts.length > 0) { %>
    <!-- 最近文章 - 最新 18 篇 -->
    <div class="post-grid-title"><i class="far fa-clock"></i>&nbsp;&nbsp;最近文章</div>
    <div class="post-grid-section">
    <div class="post-grid">
        <% recentPosts.forEach(function(post) { %>
        <% if (post.hide != true) { %>
        <div class="post-grid-card">
            <a href="<%- url_for(post.path) %>" class="pg-image">
                <% if (post.img) { %>
                <img src="<%- url_for(post.img) %>" alt="<%= post.title %>">
                <% } else { %>
                <%
                    var featureImages = theme.featureImages;
                    var featureimg = featureImages[Math.abs(hashCode(post.title) % featureImages.length)]
                %>
                <img src="<%- theme.jsDelivr.url %><%- url_for(featureimg) %>" alt="<%= post.title %>">
                <% } %>
                <span class="pg-title"><%= post.title %></span>
            </a>
            <div class="pg-body">
                <div class="pg-summary"><%- smart_summary(post) %></div>
                <div class="pg-meta">
                    <span><i class="far fa-clock fa-fw"></i><%= date(post.date, config.date_format) %></span>
                    <span>
                        <% if (post.categories && post.categories.length > 0) { %>
                        <i class="fas fa-bookmark fa-fw"></i>
                        <% post.categories.forEach(function(cat, idx) { %>
                            <% if (idx > 0) { %> / <% } %>
                            <a href="<%- url_for(cat.path) %>"><%- cat.name %></a>
                        <% }); %>
                        <% } else { %>
                        <i class="fas fa-user fa-fw"></i><%- config.author %>
                        <% } %>
                    </span>
                </div>
            </div>
        </div>
        <% } %>
        <% }); %>
    </div>
    </div>
    <% } %>

    <!-- 全部文章 -->
    <div class="post-grid-title"><i class="fas fa-list"></i>&nbsp;&nbsp;全部文章</div>
    <div class="post-grid-section">
    <div class="post-grid">
        <% page.posts.forEach(function(post) { %>
        <% if (post.hide != true) { %>
        <div class="post-grid-card">
            <a href="<%- url_for(post.path) %>" class="pg-image">
                <% if (post.img) { %>
                <img src="<%- url_for(post.img) %>" alt="<%= post.title %>">
                <% } else { %>
                <%
                    var featureimg = '/medias/featureimages/0.jpg';
                    var featureImages = theme.featureImages;
                    if (!featureImages || featureImages.length == 0) {
                        return featureimg;
                    }
                    featureimg = featureImages[Math.abs(hashCode(post.title) % featureImages.length)]
                %>
                <img src="<%- theme.jsDelivr.url %><%- url_for(featureimg) %>" alt="<%= post.title %>">
                <% } %>
                <span class="pg-title"><%= post.title %></span>
            </a>
            <div class="pg-body">
                <div class="pg-summary"><%- smart_summary(post) %></div>
                <div class="pg-meta">
                    <span><i class="far fa-clock fa-fw"></i><%= date(post.date, config.date_format) %></span>
                    <span>
                        <% if (post.categories && post.categories.length > 0) { %>
                        <i class="fas fa-bookmark fa-fw"></i>
                        <% post.categories.forEach(function(cat, idx) { %>
                            <% if (idx > 0) { %> / <% } %>
                            <a href="<%- url_for(cat.path) %>"><%- cat.name %></a>
                        <% }); %>
                        <% } else if (post.author && post.author.length > 0) { %>
                        <i class="fas fa-user fa-fw"></i><%- post.author %>
                        <% } else { %>
                        <i class="fas fa-user fa-fw"></i><%- config.author %>
                        <% } %>
                    </span>
                </div>
            </div>
        </div>
        <% } %>
        <% }); %>
    </div>
    </div>

</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
