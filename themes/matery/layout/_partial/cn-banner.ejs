<div id="cn-region-banner" class="cn-region-banner" hidden>
  <div class="cn-region-banner__inner">
    <span class="cn-region-banner__icon" aria-hidden="true">🇨🇳</span>
    <div class="cn-region-banner__text">
      <strong>检测到你可能在内地</strong>
      <span>建议切换到国内站 <code>growdu.cn</code> 获得更快的访问速度</span>
    </div>
    <a class="cn-region-banner__btn" href="<%= cnTarget %>" rel="noopener">立即前往</a>
    <button class="cn-region-banner__close" type="button" aria-label="关闭">×</button>
  </div>
</div>
<script>
(function() {
  if (typeof window === 'undefined') return;
  var banner = document.getElementById('cn-region-banner');
  if (!banner) return;
  var host = window.location.hostname;
  if (host === 'growdu.cn' || host === 'www.growdu.cn') {
    banner.hidden = true;
    return;
  }
  var dismissed = false;
  try { dismissed = localStorage.getItem('cn-banner-dismissed') === '1'; } catch (e) {}
  if (dismissed) return;
  // Heuristic: cn timezone OR Chinese navigator language
  var lang = (navigator.language || navigator.userLanguage || '').toLowerCase();
  var isCN = (lang === 'zh-cn' || lang.indexOf('zh-hans') === 0 || lang === 'zh');
  if (!isCN && Intl && Intl.DateTimeFormat) {
    try {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      if (tz === 'Asia/Shanghai' || tz === 'Asia/Chongqing' || tz === 'Asia/Harbin' || tz === 'Asia/Urumqi' || tz === 'Asia/Hong_Kong') {
        isCN = true;
      }
    } catch (e) {}
  }
  if (!isCN) return;
  banner.hidden = false;
  var close = banner.querySelector('.cn-region-banner__close');
  if (close) {
    close.addEventListener('click', function() {
      banner.hidden = true;
      try { localStorage.setItem('cn-banner-dismissed', '1'); } catch (e) {}
    });
  }
})();
</script>
