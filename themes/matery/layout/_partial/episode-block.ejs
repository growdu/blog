<%/*
  Episode block — the master draft IS the episode page (契约七 §4.2, 方案 A).

  Renders only on pages whose front matter carries `episode:` — that is, the
  six master drafts.  Ordinary articles never see this block.

  Two data sources:

  * the page's own front matter (hook / duration / license / sources /
    repro).  Those fields reach the content unit through the publish
    contract's passthrough (publish/spec/08 §4.3.1), so they are the master
    draft's own words — the draft is the single source of truth.
  * ``source/_data/podcast_index.json`` — the episode line as a whole:
    every episode's number, title and address, plus where each one was
    published.  Built by ``tools/build-podcast-index.py``.

  The cut itself is **not hosted here** (成片不在站点托管): the player is
  the Bilibili iframe taken from the publish link, everything else links
  out.  A cut that has not been published yet shows no player — the block
  says so rather than pretending.

  The main diagram is passed in as a local (`figure`) by post-detail.ejs:
  it is lifted out of the article body so the diagram appears exactly once
  (see 契约七 §4.2 第 3 行).
*/%>
<%
var podcastIndex = (site.data && site.data.podcast_index) ? site.data.podcast_index : null;
var episodeRows = (podcastIndex && podcastIndex.episodes) ? podcastIndex.episodes : [];
var episodeSlug = page.episode || '';
var episodeNow = null;
var episodePos = -1;
episodeRows.forEach(function (item, index) {
  if (item.episode === episodeSlug) { episodeNow = item; episodePos = index; }
});
var episodePrev = episodePos > 0 ? episodeRows[episodePos - 1] : null;
var episodeNext = (episodePos >= 0 && episodePos < episodeRows.length - 1) ? episodeRows[episodePos + 1] : null;

/* 已发布的平台：有 published_url 才算「发出去过」。 */
var episodeBvid = '';
var episodePlatforms = [];
if (episodeNow && episodeNow.platforms) {
  episodeNow.platforms.forEach(function (item) {
    if (!item.published_url) { return; }
    var bvidMatch = item.published_url.match(/BV[0-9A-Za-z]+/);
    if (bvidMatch) { episodeBvid = bvidMatch[0]; }
    episodePlatforms.push(item);
  });
}
var episodeLabel = episodeNow ? (episodeNow.episode_label || ('EP' + episodeNow.episode_no)) : '';
var episodeFigure = (typeof figure !== 'undefined' && figure) ? figure : null;
%>
<% if (episodeNow) { %>
<div class="card episode-block" data-aos="fade-up">
  <div class="card-content">

    <div class="episode-head">
      <span class="episode-no"><%= episodeLabel %></span>
      <span class="episode-title"><%= episodeNow.title %></span>
      <% if (episodeNow.series) { %>
      <span class="episode-series"><%= episodeNow.series %></span>
      <% } %>
    </div>

    <% if (episodeNow.hook) { %>
    <div class="episode-hook"><%= episodeNow.hook %></div>
    <% } %>

    <% if (episodeBvid) { %>
    <div class="episode-player">
      <iframe src="//player.bilibili.com/player.html?bvid=<%= episodeBvid %>&page=1"
              scrolling="no" frameborder="0" allowfullscreen="true"></iframe>
    </div>
    <% } else { %>
    <div class="episode-player episode-player--none">
      <% if (episodePlatforms.length) { %>
      这一期的视频还没发到 B站——发出去之后这里会出现播放器。
      <% } else { %>
      这一期的视频还没发出去——发出去之后这里会出现播放器。
      <% } %>
    </div>
    <% } %>

    <% if (episodePlatforms.length) { %>
    <div class="episode-platforms">
      <% episodePlatforms.forEach(function (item) { %>
      <a class="episode-platform" href="<%- item.published_url %>" target="_blank" rel="noopener">在<%= item.label || item.platform_name %>看</a>
      <% }) %>
    </div>
    <% } %>

    <% if (episodeFigure && episodeFigure.diagram) { %>
    <div class="episode-figure">
      <div class="episode-figure-label">本期机制图</div>
      <%- episodeFigure.diagram %>
      <% if (episodeFigure.caption) { %>
      <div class="episode-figure-caption"><%- episodeFigure.caption %></div>
      <% } %>
    </div>
    <% } %>

    <%# 2026-11-19：系列页（/videos/）退休了，订阅入口跟着搬到这里 ——
        每一期文章页的顶部就是这条期号线，订阅链接放在这儿，读者不用
        先找到一个合集页。 %>
    <div class="episode-subscribe">
      订阅播客：<a href="<%- url_for('/feed.xml') %>">RSS feed</a>（每期带旁白音频）
    </div>

    <div class="episode-meta">
      <% if (episodeNow.duration_s) { %>
      <span class="episode-meta-item">时长 <%= Math.round(episodeNow.duration_s) %> 秒</span>
      <% } %>
      <% if (episodeNow.license) { %>
      <span class="episode-meta-item">出处 <%= episodeNow.license %></span>
      <% } %>
      <% if (episodeNow.date) { %>
      <span class="episode-meta-item">更新 <%= episodeNow.date %></span>
      <% } %>
      <% if (episodeNow.video_url) { %>
      <a class="episode-meta-link" href="<%- url_for(episodeNow.video_url) %>">看口播稿与字幕</a>
      <% } %>
    </div>

    <% if ((episodeNow.sources && episodeNow.sources.length) || (episodeNow.repro && episodeNow.repro.length)) { %>
    <details class="episode-detail">
      <summary>源码与复现</summary>
      <% if (episodeNow.sources && episodeNow.sources.length) { %>
      <div class="episode-detail-label">源码路径</div>
      <ul class="episode-sources">
        <% episodeNow.sources.forEach(function (item) { %>
        <li><code><%= item %></code></li>
        <% }) %>
      </ul>
      <% } %>
      <% if (episodeNow.repro && episodeNow.repro.length) { %>
      <div class="episode-detail-label">可复制的命令</div>
      <pre class="episode-repro"><code><%= (episodeNow.repro || []).join('\n') %></code></pre>
      <% } %>
    </details>
    <% } %>

    <% if (episodePrev || episodeNext) { %>
    <%# 用 <div> 而不是 <nav>：Materialize 按**元素名**给 nav 上样式
        （nav{height:64px;line-height:64px;background-color:#ee6e73}），
        这一块会被渲染成一条红色横条、白字，在文章正中间非常突兀。
        参见 tests/test_content_nav_not_materialize_navbar.py。 %>
    <div class="episode-nav">
      <% if (episodePrev) { %>
      <a class="episode-nav-item" href="<%- url_for(episodePrev.url) %>">上一期 <%= episodePrev.episode_label %></a>
      <% } %>
      <% if (episodeNext) { %>
      <a class="episode-nav-item" href="<%- url_for(episodeNext.url) %>">下一期 <%= episodeNext.episode_label %></a>
      <% } %>
      <%# 2026-11-19：这一行「全部期号」删掉了 —— 它指向的系列页
          （/videos/）整个退休了，留着就是一个死链。期号线本身还在：
          上一期 / 下一期还能走，RSS 订阅（/feed.xml）也没动。 %>
    </div>
    <% } %>

  </div>
</div>
<% } %>
