<%/*
  Learning path section — 6 curated reading lanes for new visitors.
  Each lane auto-discovers the top-3 rated posts from its source categories,
  so curators don't need to keep a hand-maintained list in sync.
  Falls back to random sampling if no `top` field is set.
*/%>
<% if (is_home() && page.current === 1) { %>
<%
  // Each lane: icon, title, blurb, category filter (matched against
  // post.path first segment, e.g. "dpdk/vpp-intro/..." -> "dpdk").
  var lanes = [
    { id: 'db',      icon: 'fa-solid fa-database',     title: '数据库内核',   desc: '从 PostgreSQL 编译调试到存储、MVCC、WAL 与复制源码', pathPrefix: 'db/postgresql/learning-path/' },
    { id: 'hpn',     icon: 'fa-solid fa-network-wired', title: '高性能网络',   desc: 'DPDK / VPP / 用户态协议栈实战',                  cats: ['dpdk', 'protocol', 'network'] },
    { id: 'dist',    icon: 'fa-solid fa-server',        title: '分布式系统',   desc: '集群、共识、分布式一致性',                       cats: ['cluster', 'code', 'go_web'] },
    { id: 'ai',      icon: 'fa-solid fa-brain',         title: 'AI 与大模型', desc: '从感知机到 ChatGPT：原理与工具',                cats: ['ai', 'chatgpt'] },
    { id: 'os',      icon: 'fa-solid fa-microchip',     title: '操作系统与底层', desc: 'C / Linux / 内核开发',                         cats: ['language', 'linux', 'computer_communication'] },
    { id: 'mind',    icon: 'fa-solid fa-mountain-sun',  title: '思考与工具',   desc: '程序员素养、股票、对联、人生',                  cats: ['stock', 'programmer_self_cultivation', 'tools', 'hometown', 'alg', 'faq'] },
  ];

  // Map: post -> directory name (lowercased).
  // Hexo's `post.path` is the URL path *without* the leading slash, so
  // it splits into ['YYYY', 'MM', 'DD', '<dir>', '<slug>'] — the directory
  // lives at index 3, not 4. (Earlier this used parts[4], which only
  // matched the few posts whose slug happened to coincide with one of
  // the lane categories — that's why the db/hpn/dist lanes used to
  // show just 1 post or none at all.)
  // We use the directory instead of categories.* so the result is always
  // lowercase ASCII/whatever-the-folder-is, and case-insensitive matching
  // is trivial.
  function laneOf(post) {
    var parts = (post.path || '').split('/');
    return parts.length >= 4 ? parts[3].toLowerCase() : '';
  }

  // A lane with pathPrefix matches the series directory exactly, rather
  // than accidentally including every post in the same top-level folder.
  function matchesLane(post, lane) {
    var path = (post.path || '').toLowerCase();
    return lane.pathPrefix
      ? path.indexOf('/' + lane.pathPrefix.toLowerCase()) !== -1
      : lane.cats.indexOf(laneOf(post)) !== -1;
  }

  // Pick the most common category among a lane's posts so the “查看更多”
  // link lands on the right category page (instead of the generic
  // /categories/ that the card previously pointed to).
  function primaryCat(posts) {
    var counts = {};
    posts.forEach(function (p) {
      (p.categories && p.categories.data || []).forEach(function (c) {
        counts[c.name] = (counts[c.name] || 0) + 1;
      });
    });
    var best = null, bestN = 0;
    Object.keys(counts).forEach(function (k) {
      if (counts[k] > bestN) { best = k; bestN = counts[k]; }
    });
    return best;
  }

  // For each lane, collect ALL matching posts (so primaryCat sees the full
  // picture), then pick the lane's representative category, and slice the
  // top-3 for display.
  lanes.forEach(function (lane) {
    var matched = site.posts.data
      .filter(function (p) { return matchesLane(p, lane); });
    lane.matched = matched;
    lane.primaryCat = primaryCat(matched);
    matched.sort(function (a, b) {
      var td = (b.top || 0) - (a.top || 0);
      if (td !== 0) return td;
      if (lane.pathPrefix) {
        var an = parseInt(a.title, 10), bn = parseInt(b.title, 10);
        if (!isNaN(an) && !isNaN(bn) && an !== bn) return an - bn;
      }
      return b.date - a.date;
    });
    lane.posts = matched.slice(0, 3);
  });
%>

<section class="learning-path" data-aos="fade-up">
  <div class="container">
    <div class="section-title">
      <h2><i class="fas fa-compass"></i>&nbsp; 学习路径</h2>
      <p class="section-subtitle">如果你想学某方向，从这里开始 — 每条线精选 3 篇代表作</p>
    </div>

    <div class="lane-grid">
      <% lanes.forEach(function (lane) { %>
      <div class="lane-card lane-card--<%= lane.id %>">
        <div class="lane-card__head">
          <i class="<%= lane.icon %> lane-card__icon"></i>
          <h3 class="lane-card__title"><%= lane.title %></h3>
        </div>
        <p class="lane-card__desc"><%= lane.desc %></p>
        <ul class="lane-card__posts">
          <% lane.posts.forEach(function (post) { %>
            <li>
              <i class="fas fa-chevron-right"></i>
              <a class="lane-card__post-link" href="<%- url_for(post.path) %>" title="<%= post.title %>"><%= post.title %></a>
            </li>
          <% }); %>
        </ul>
        <% if (lane.posts.length === 0) { %>
          <p class="lane-card__empty">该方向持续更新中</p>
        <% } %>
        <% if (lane.primaryCat) { %>
        <a class="lane-card__more" href="<%- url_for('/categories/' + lane.primaryCat + '/') %>">
          查看更多 <i class="fas fa-arrow-right"></i>
        </a>
        <% } else { %>
        <div class="lane-card__more">
          查看更多 <i class="fas fa-arrow-right"></i>
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
