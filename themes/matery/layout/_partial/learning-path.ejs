<%/*
  学习路径面板 —— 首页上的 8 条赛道入口。

  **数据从哪来**
  `tools/build-learning-path.py` 把全站文章按「赛道 + 阶段」归类，生成
  `source/_data/learning.json`。这个模板只负责把赛道画出来：
  赛道数、文章数、简介、阶段顺序都从数据里读，**不写死在模板里**。
  改路径请改 `data/learning-path.json`（规则）后重新生成，
  不要在这里手改文章列表 —— 那样规则和页面就会各说各话。

  **没有数据就不画**
  数据文件是构建产物。没跑生成器（比如本地只跑 `hexo generate`）时
  `site.data.learning` 是空的，这时整个面板不渲染，
  免得出现一个点进去什么都没有的入口。

  **不带 data-aos（2026-11-19）**
  面板只出现在首页上，而首页是「正好一屏」的固定版面：AOS 的 fade-up
  会把面板整体往下挪 100px 再淡入 —— 那 100px 让页面在动画期间比视口
  高出一截，滚动条闪一下、内容跳一下。一屏的版面不要这种入场动画。
*/%>
<%
  var _lpData = (site.data && site.data.learning) || null;
  var _lpTracks = (_lpData && _lpData.tracks) || [];
%>
<% if (is_home() && page.current === 1 && _lpTracks.length) { %>
<section class="learning-path">
  <div class="container">
    <%# 标题行：左边标题 + 副标题，右边「看完整的学习地图」。
        2026-11-18：这条链接原来单独占一行（32px），首页要做成正好一屏，
        就挪到标题行右边去了 —— 位置一样好找，高度省下来给卡片。 %>
    <div class="section-title">
      <h2><i class="fas fa-compass"></i>&nbsp; 学习路径</h2>
      <p class="section-subtitle">
        全站 <%= _lpData.total %> 篇文章分成 <%= _lpTracks.length %> 条赛道 —— 每条都排好了顺序，挑一条走
      </p>
      <a class="learning-path__all-link" href="<%- url_for('/learning/') %>">
        看完整的学习地图<i class="fas fa-arrow-right"></i>
      </a>
    </div>

    <div class="lane-grid lane-grid--tracks">
      <% _lpTracks.forEach(function (track) {
           var _stages = track.stages || []; %>
      <a class="lane-card lane-card--<%= track.id %>" href="<%- url_for('/learning/' + track.id + '/') %>">
        <div class="lane-card__head">
          <i class="<%= track.icon %> lane-card__icon"></i>
          <h3 class="lane-card__title"><%= track.title %></h3>
          <span class="lane-card__count"><%= track.count %> 篇</span>
        </div>
        <p class="lane-card__desc"><%= track.summary %></p>
        <ul class="lane-card__stages">
          <% _stages.forEach(function (stage) { %>
            <li class="lane-card__stage">
              <span class="lane-card__stage-id"><%= stage.id %></span>
              <span class="lane-card__stage-title"><%= stage.title %></span>
            </li>
          <% }); %>
          <%# 「+N 个阶段」——首页的卡片只放得下第一个阶段，后面几个折成
              一个数字（完整阶段表在 /learning/<track>/ 那一页）。
              2026-11-18：首页要做成正好一屏，八张卡各列出全部阶段的话
              卡片高度翻三倍，页面就得滚两屏。 %>
          <% if (_stages.length > 1) { %>
            <li class="lane-card__stage lane-card__stage--rest">+<%= _stages.length - 1 %> 个阶段</li>
          <% } %>
        </ul>
        <span class="lane-card__more">从这条赛道开始 <i class="fas fa-arrow-right"></i></span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
