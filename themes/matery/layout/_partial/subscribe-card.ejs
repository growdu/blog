<%/*
  Footer "Stay Connected" card.
  Renders RSS + external subscriptions before the standard copyright row.
  Placeholders: edit the URLs in _config.matery.yml's `subscribe:` block.
*/%>

<%
  var sub = (typeof theme.subscribe !== 'undefined' && theme.subscribe) || {};
%>
<div class="subscribe-card">
  <h3 class="subscribe-card__title">
    <i class="fas fa-paper-plane"></i>&nbsp; 保持联系
  </h3>
  <p class="subscribe-card__lead">有更新第一时间送达 — 选一个你顺手的方式</p>
  <div class="subscribe-card__row">
    <% if (sub.rss !== false) { %>
      <a class="subscribe-chip" href="<%- url_for('/atom.xml') %>">
        <i class="fas fa-rss"></i>&nbsp; RSS
      </a>
    <% } %>
    <% if (sub.zhihu) { %>
      <a class="subscribe-chip" href="<%= sub.zhihu %>" target="_blank" rel="noopener noreferrer external nofollow">
        <i class="fab fa-zhihu"></i>&nbsp; 知乎
      </a>
    <% } %>
    <% if (sub.wechat) { %>
      <button type="button" class="subscribe-chip subscribe-chip--qr" data-wechat-qr-toggle aria-haspopup="dialog" aria-controls="wechat-qr-modal">
        <i class="fab fa-weixin"></i>&nbsp; 公众号
      </button>
    <% } %>
    <% if (sub.github) { %>
      <a class="subscribe-chip" href="<%= sub.github %>" target="_blank" rel="noopener noreferrer external nofollow">
        <i class="fab fa-github"></i>&nbsp; GitHub
      </a>
    <% } %>
    <% if (sub.email) { %>
      <a class="subscribe-chip" href="mailto:<%= sub.email %>" rel="noopener">
        <i class="fas fa-envelope"></i>&nbsp; 邮件
      </a>
    <% } %>
    <% if (sub.bilibili) { %>
      <a class="subscribe-chip" href="<%= sub.bilibili %>" target="_blank" rel="noopener noreferrer external nofollow">
        <i class="fab fa-bilibili"></i>&nbsp; B站
      </a>
    <% } %>
  </div>
  <% if (sub.note) { %>
    <p class="subscribe-card__note"><%= sub.note %></p>
  <% } %>
</div>

<% if (sub.wechat) { %>
<div class="wechat-qr-modal" id="wechat-qr-modal" hidden role="dialog" aria-modal="true" aria-labelledby="wechat-qr-title">
  <div class="wechat-qr-modal__backdrop" data-wechat-qr-close></div>
  <div class="wechat-qr-modal__panel" role="document">
    <button type="button" class="wechat-qr-modal__close" data-wechat-qr-close aria-label="关闭">&times;</button>
    <h4 class="wechat-qr-modal__title" id="wechat-qr-title">
      <i class="fab fa-weixin"></i>&nbsp; 微信公众号
    </h4>
    <div class="wechat-qr-modal__img-wrap">
      <img class="wechat-qr-modal__img" src="<%= sub.wechat %>" alt="公众号二维码">
    </div>
    <p class="wechat-qr-modal__tip">微信扫一扫，关注「growdu」</p>
  </div>
</div>
<script>
(function(){
  var modal = document.getElementById('wechat-qr-modal');
  if (!modal) return;
  var openBtns = document.querySelectorAll('[data-wechat-qr-toggle]');
  if (!openBtns.length) return;
  var lastFocus = null;

  function open() {
    lastFocus = document.activeElement;
    modal.removeAttribute('hidden');
    document.body.classList.add('wechat-qr-modal-open');
    var closeBtn = modal.querySelector('.wechat-qr-modal__close');
    if (closeBtn) closeBtn.focus();
  }
  function close() {
    if (modal.hasAttribute('hidden')) return;
    modal.setAttribute('hidden', '');
    document.body.classList.remove('wechat-qr-modal-open');
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  openBtns.forEach(function(btn){ btn.addEventListener('click', open); });
  modal.addEventListener('click', function(e){
    if (e.target.closest('[data-wechat-qr-close]')) close();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) close();
  });
})();
</script>
<% } %>
