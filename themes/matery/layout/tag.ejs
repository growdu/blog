<%- partial('_partial/bg-cover') %>

<main class="content">

    <%- partial('_widget/tag-cloud') %>

        <div class="tag-post-list">
        <% page.posts.sort('date').reverse().forEach(function(post) { %>
        <article class="tag-post-item">
            <div class="tag-post-body">
                <h2 class="tag-post-title">
                    <a href="<%- url_for(post.path) %>" title="<%= post.title %>"><%= post.title %></a>
                </h2>
                <% if (post.excerpt) { %>
                <p class="tag-post-excerpt"><%- strip_html(post.excerpt) %></p>
                <% } else { %>
                <p class="tag-post-excerpt"><%- smart_summary(post) %></p>
                <% } %>
                <div class="publish-info">
                    <span class="publish-date">
                        <i class="far fa-clock fa-fw icon-date"></i><%= date(post.date, config.date_format) %>
                    </span>
                    <% if (post.categories && post.categories.length > 0) { %>
                    <span class="publish-author">
                        <i class="fas fa-bookmark fa-fw icon-category"></i>
                        <% post.categories.forEach(function(category) { %>
                        <a href="<%- url_for(category.path) %>" class="post-category"><%- category.name %></a>
                        <% }); %>
                    </span>
                    <% } %>
                </div>
            </div>
        </article>
        <% }); %>
    </div>

</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
